# Copy to .env. Leave a section empty to keep that part in MOCK mode.
# After editing, run: npm run check

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Azure OpenAI model deployment (Azure AI Foundry portal > Deployments)
# Endpoint of the resource, like https://<resource>.openai.azure.com/openai/v1/
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Deployment name; Azure OpenAI takes it as the model name
AZURE_OPENAI_DEPLOYMENT=
# Optional: model name shown in the header badge (defaults to the deployment name)
# AZURE_OPENAI_MODEL=gpt-6.1-sol

# azure-openai or mock; without this line it is azure-openai when AZURE_OPENAI_API_KEY is set
# AI_PROVIDER=azure-openai
# PORT=8790
